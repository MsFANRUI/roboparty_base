#!/bin/bash
set -e

mkdir -p /opt/roboparty/{lib,include,bin,share}

PYTHON_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
mkdir -p "/opt/roboparty/lib/python${PYTHON_VER}/site-packages"

ldconfig

# Set CMAKE_PREFIX_PATH and PKG_CONFIG_PATH for /opt/roboparty
cat > /etc/profile.d/roboparty.sh << 'EOF'
export PATH=/opt/roboparty/bin${PATH:+:$PATH}
export CMAKE_PREFIX_PATH=/opt/roboparty${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}
export PKG_CONFIG_PATH=/opt/roboparty/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
EOF
chmod 644 /etc/profile.d/roboparty.sh

# Add /opt/roboparty/bin to sudo secure_path
cp /etc/sudoers /etc/sudoers.bak
sed -i '/secure_path/s|"$|:/opt/roboparty/bin"|' /etc/sudoers

# Reload udev rules and trigger device events
udevadm control --reload-rules
# Free the numeric CAN names before USB adapters enumerate. These rules match
# add events; the default change event cannot rename existing onboard CANs.
# Leave active interfaces alone when upgrading a running robot.
for can_path in /sys/devices/platform/fea{5,6,7}0000.can/net/*; do
    [ -r "$can_path/flags" ] || continue
    can_flags=$(cat "$can_path/flags")
    if (( can_flags & 1 )); then
        continue
    fi
    udevadm trigger --action=add "$can_path"
    udevadm settle
done
udevadm trigger --subsystem-match=tty
udevadm trigger --subsystem-match=net
udevadm trigger --subsystem-match=misc
